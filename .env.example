# ── Devlogr Environment Variables ──────────────────────────────
# Copy this file to ".env" and fill in your real values.
# Never commit your real .env file.

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
# Example Atlas URI: mongodb+srv://<user>:<password>@cluster0.mongodb.net/devlogr
MONGODB_URI=mongodb://127.0.0.1:27017/devlogr

# Session secret — any long random string
SESSION_SECRET=change_this_to_a_long_random_secret_string

# Admin panel password (plain text here; it is hashed on first boot — see README)
ADMIN_PASSWORD=change_this_password

# GitHub usernames whose repos should be pulled into the "Projects" sections
GITHUB_USERNAMES=DeveloperPuneet,SovereignPuneet,Puneet-Kumar2010

# Optional: a GitHub Personal Access Token (no scopes needed, just "public_repo" read)
# raises the GitHub API rate limit from 60/hr to 5,000/hr. Strongly recommended.
GITHUB_TOKEN=

# Contact / social info shown on the site (can also be edited later from Admin > Links)
CONTACT_EMAIL=developerpuneet2010@gmail.com
INSTAGRAM_HANDLE=_puneet_kumar_mishra_

# How often (minutes) to refresh the cached GitHub repo data
GITHUB_CACHE_MINUTES=30

# Bot protection. A signature exceeding either limit is blocked for four months.
SECURITY_REQUEST_LIMIT=120
SECURITY_LONG_REQUEST_LIMIT=600
# Set true only when the app is behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false
