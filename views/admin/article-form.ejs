<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="page-admin">
  <div class="admin-shell">
    <%- include('partials/sidebar') %>

    <main class="admin-main">
      <div class="admin-topbar">
        <div>
          <h1><%= article ? 'Edit Article' : 'New Article' %></h1>
          <p class="admin-sub">Content supports raw HTML tags: &lt;h1&gt;, &lt;h2&gt;, &lt;p&gt;, &lt;img src=""&gt;, &lt;a&gt;, &lt;blockquote&gt;, &lt;code&gt;, &lt;ul&gt;/&lt;li&gt; and more. Scripts are stripped for safety.</p>
        </div>
        <a href="/admin/articles" class="btn btn-ghost">← Back to articles</a>
      </div>

      <form method="POST" action="<%= article ? '/admin/articles/' + article._id + '/edit' : '/admin/articles/new' %>" class="article-form">
        <div class="form-grid">
          <div class="form-col-main">
            <label>Title</label>
            <input type="text" name="title" required value="<%= article ? article.title : '' %>" placeholder="How I built a Q-learning grid shooter AI" />

            <label>Excerpt <span class="label-hint">(optional — auto-generated if left blank)</span></label>
            <textarea name="excerpt" rows="2" placeholder="A short teaser shown on cards..."><%= article ? article.excerpt : '' %></textarea>

            <label>Cover Image URL <span class="label-hint">(optional)</span></label>
            <input type="text" name="coverImage" value="<%= article ? article.coverImage : '' %>" placeholder="https://... or /images/cover.jpg" />

            <div class="editor-tabs">
              <button type="button" class="editor-tab active" data-editor-tab="write">✏️ Write HTML</button>
              <button type="button" class="editor-tab" data-editor-tab="preview">👁️ Preview</button>
            </div>

            <div class="editor-pane active" data-editor-pane="write">
              <label>Content (raw HTML)</label>
              <textarea id="contentField" name="content" rows="18" required placeholder="<h1>My heading</h1>&#10;<p>Some text...</p>&#10;<img src=&quot;https://example.com/pic.png&quot; alt=&quot;pic&quot; />"><%= article ? article.content : '' %></textarea>
            </div>

            <div class="editor-pane" data-editor-pane="preview">
              <div id="previewBox" class="article-body glass preview-box"></div>
            </div>
          </div>

          <div class="form-col-side">
            <div class="form-side-card glass">
              <label>Tags <span class="label-hint">(comma separated)</span></label>
              <input type="text" name="tags" value="<%= article ? article.tags.join(', ') : '' %>" placeholder="javascript, ai, tutorial" />

              <label class="checkbox-row">
                <input type="checkbox" name="published" <%= (!article || article.published) ? 'checked' : '' %> />
                Published (visible on the site)
              </label>

              <button type="submit" class="btn btn-primary btn-block"><%= article ? 'Save Changes' : 'Publish Article' %></button>
            </div>
          </div>
        </div>
      </form>
    </main>
  </div>
  <script src="/js/admin.js"></script>
</body>
</html>
